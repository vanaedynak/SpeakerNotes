{
  "name": "speakernotes",
  "productName": "SpeakerNotes",
  "version": "1.0.0",
  "description": "Бесконечная доска для фраз и скриптов разговора — iPad, Android, Windows, macOS, Linux, Web",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "vanaedynak",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "electron": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --publish never",
    "dist:mac": "vite build && electron-builder --mac --publish never",
    "dist:linux": "vite build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "@fontsource/golos-text": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.vanaedynak.speakernotes",
    "productName": "SpeakerNotes",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "resources/icon.png",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "mac": {
      "icon": "resources/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "artifactName": "SpeakerNotes-macOS.${ext}"
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Office",
      "target": [
        "AppImage"
      ],
      "artifactName": "SpeakerNotes-Linux.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "SpeakerNotes-Windows-setup.exe"
    },
    "portable": {
      "artifactName": "SpeakerNotes-Windows-portable.exe"
    }
  },
  "homepage": "https://github.com/vanaedynak/SpeakerNotes"
}
